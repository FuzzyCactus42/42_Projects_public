# Zsh completion and Red Hour gradient prompt.
autoload -U colors && colors
# Additional completion definitions must be available before compinit.
if [[ -d ~/.config/zsh/plugins/zsh-completions/src ]]; then
  fpath=("$HOME/.config/zsh/plugins/zsh-completions/src" ${fpath:#"$HOME/.config/zsh/plugins/zsh-completions/src"})
fi
autoload -Uz compinit && compinit
zmodload zsh/complist
zstyle ':completion:*' menu select

source ~/.config/zsh/deep-red.zsh

# History Settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory      
setopt sharehistory       
setopt hist_ignore_dups   

# Useful Aliases
alias ls='ls --color=auto'
alias ll='ls -lah'
alias c='clear'
alias ccf='cc -Wall -Wextra -Werror'
# Red directory names in ls (including shared and sticky directories).
if [[ ${LS_COLORS-} != *'di=38;2;255;70;70:ow=38;2;255;70;70:tw=38;2;255;70;70:st=38;2;255;70;70:ln=target' ]]; then
  export LS_COLORS="${LS_COLORS:+${LS_COLORS}:}di=38;2;255;70;70:ow=38;2;255;70;70:tw=38;2;255;70;70:st=38;2;255;70;70:ln=target"
fi

# Match completion colors to ls, with a dark red selection.
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS} 'ma=48;2;70;5;12;38;2;255;235;235'

# Programmer tools: pairing first, then suggestions and highlighting.
# Pair brackets and quotes automatically; keep ordinary spaces unchanged.
if [[ -r ~/.config/zsh/plugins/zsh-autopair/autopair.zsh ]] && (( ! $+functions[autopair-init] )); then
  AUTOPAIR_INHIBIT_INIT=1
  source ~/.config/zsh/plugins/zsh-autopair/autopair.zsh
  unset 'AUTOPAIR_PAIRS[ ]'
  autopair-init
fi

# Jump to frequently visited folders with: z part-of-folder-name
if [[ -r ~/.config/zsh/plugins/zsh-z/zsh-z.plugin.zsh ]] && (( ! $+functions[zshz] )); then
  ZSHZ_DATA=${ZSHZ_DATA:-$HOME/.config/zsh/z-history}
  source ~/.config/zsh/plugins/zsh-z/zsh-z.plugin.zsh
fi


ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#a58a90'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=80
if [[ -r ~/.config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && (( ! $+functions[_zsh_autosuggest_start] )); then
  source ~/.config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
if [[ -r ~/.config/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && (( ! $+functions[_zsh_highlight] )); then
  source ~/.config/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
if (( $+parameters[ZSH_HIGHLIGHT_STYLES] )); then
  ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff5555,bold,underline'
  ZSH_HIGHLIGHT_STYLES[path]='fg=#ff9292,underline'
fi

# This history plugin integrates with highlighting when loaded after it.
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#46050c,fg=#fff1f1,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=#ff5555,bold,underline'
if [[ -r ~/.config/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && (( ! $+functions[history-substring-search-up] )); then
  source ~/.config/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
fi
if (( $+functions[history-substring-search-up] )); then
  bindkey -M emacs '^[[A' history-substring-search-up
  bindkey -M emacs '^[[B' history-substring-search-down
  bindkey -M emacs '^[OA' history-substring-search-up
  bindkey -M emacs '^[OB' history-substring-search-down
  bindkey -M viins '^[[A' history-substring-search-up
  bindkey -M viins '^[[B' history-substring-search-down
  bindkey -M viins '^[OA' history-substring-search-up
  bindkey -M viins '^[OB' history-substring-search-down
fi
